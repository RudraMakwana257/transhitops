# Production Environment Configuration Template
# Never reuse these values across environments. Generate unique secrets per environment with python -c "import secrets; print(secrets.token_hex(32))".
FLASK_ENV=production
SECRET_KEY=generate-secure-random-key-here
JWT_SECRET_KEY=generate-secure-jwt-key-here

# Database Configuration
POSTGRES_SERVER=pg-primary.transitops-db.internal
POSTGRES_DB=transitops_prod
POSTGRES_USER=transit_admin
POSTGRES_PASSWORD=replace_with_vault_secret

# Redis Cache & Sentinel
REDIS_URL=redis://redis-sentinel.transitops.internal:6379/0

# AI Provider API Keys
# GROQ_API_KEY is required in production. The app will not boot (RuntimeError at boot) without it.
# Provision it from the production secrets manager (e.g. AWS Secrets Manager, HashiCorp Vault).
GROQ_API_KEY=gsk_replace_with_production_key

# Email (SMTP) Configuration
# SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, and EMAIL_FROM are required in production.
# The app will not boot (RuntimeError at boot) without them.
# Provision credentials from the production secrets manager.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace_with_smtp_password_or_apikey
SMTP_USE_TLS=true
EMAIL_FROM=noreply@transitops.com


# Operations & Observability
LOG_LEVEL=INFO
ENABLE_AUDIT_LOGGING=true
OPENTELEMETRY_EXPORTER_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4317
PROMETHEUS_METRICS_ENABLED=true
