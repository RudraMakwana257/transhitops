# Database
DATABASE_URL=postgresql://transitops:changeme@postgres:5432/transitops
POSTGRES_USER=transitops
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transitops

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_SECRET_KEY=change-this-to-a-different-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRES=28800
JWT_REFRESH_TOKEN_EXPIRES=604800

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost,https://yourdomain.com

# AI
GROQ_API_KEY=your-groq-api-key-here

# Security
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_LOGIN=5/minute

# App
APP_NAME=TransitOps
APP_VERSION=1.0.0
LOG_LEVEL=info
